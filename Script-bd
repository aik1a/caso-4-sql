-- 3. CINCO CONSULTAS DE LA PRESENTACION

-- Consulta 1: ¿Que veterinarios tiene cada clinica?
SELECT c.nombre AS clinica,
       v.nombre_completo AS veterinario
FROM clinica AS c
LEFT JOIN veterinario AS v
    ON c.codigo_clinica = v.codigo_clinica
ORDER BY c.codigo_clinica, v.id_veterinario;

-- Consulta 2: ¿Que pacientes tiene cada dueno?
SELECT d.nombre_completo AS dueno,
       p.nombre AS paciente
FROM dueno AS d
INNER JOIN paciente AS p
    ON d.rut_dueno = p.rut_dueno
ORDER BY d.rut_dueno, p.codigo_paciente;

-- Consulta 3: ¿Quien atendio a cada paciente y en que fecha?
SELECT c.codigo_consulta AS consulta,
       c.fecha,
       p.nombre AS paciente,
       v.nombre_completo AS veterinario
FROM consulta AS c
INNER JOIN paciente AS p
    ON c.codigo_paciente = p.codigo_paciente
INNER JOIN veterinario AS v
    ON c.id_veterinario = v.id_veterinario
ORDER BY c.codigo_consulta;

-- Consulta 4: ¿Que tratamientos tienen los pacientes y en que fechas?
SELECT p.nombre AS paciente,
       t.nombre AS tratamiento,
       pt.fecha_inicio,
       pt.fecha_termino
FROM paciente_tratamiento AS pt
INNER JOIN paciente AS p
    ON pt.codigo_paciente = p.codigo_paciente
INNER JOIN tratamiento AS t
    ON pt.codigo_tratamiento = t.codigo_tratamiento
ORDER BY pt.id_asignacion;

-- Consulta 5: ¿Que procedimientos se hicieron en cada consulta?
SELECT c.codigo_consulta AS consulta,
       pr.nombre AS procedimiento,
       cp.fecha_realizacion AS fecha,
       cp.resultado
FROM consulta_procedimiento AS cp
INNER JOIN consulta AS c
    ON cp.codigo_consulta = c.codigo_consulta
INNER JOIN procedimiento AS pr
    ON cp.codigo_procedimiento = pr.codigo_procedimiento
ORDER BY cp.id_realizacion;
