CREATE DATABASE veterinarias;
USE veterinarias;

-- 1. CREACION DE TABLAS

CREATE TABLE clinica (
    codigo_clinica INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    direccion VARCHAR(200) NOT NULL,
    telefono VARCHAR(20) NOT NULL,
    ciudad VARCHAR(100) NOT NULL,
    PRIMARY KEY (codigo_clinica)
) ENGINE=InnoDB;

CREATE TABLE veterinario (
    id_veterinario INT NOT NULL,
    nombre_completo VARCHAR(150) NOT NULL,
    especialidad VARCHAR(100) NOT NULL,
    correo_electronico VARCHAR(150) NOT NULL,
    telefono VARCHAR(20) NOT NULL,
    codigo_clinica INT NOT NULL,
    PRIMARY KEY (id_veterinario),
    UNIQUE (correo_electronico),
    CONSTRAINT fk_veterinario_clinica
        FOREIGN KEY (codigo_clinica)
        REFERENCES clinica (codigo_clinica)
) ENGINE=InnoDB;

CREATE TABLE dueno (
    rut_dueno VARCHAR(15) NOT NULL,
    nombre_completo VARCHAR(150) NOT NULL,
    correo_electronico VARCHAR(150) NOT NULL,
    telefono VARCHAR(20) NOT NULL,
    direccion VARCHAR(200) NOT NULL,
    PRIMARY KEY (rut_dueno)
) ENGINE=InnoDB;

CREATE TABLE paciente (
    codigo_paciente INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    especie VARCHAR(50) NOT NULL,
    raza VARCHAR(100) NOT NULL,
    fecha_nacimiento DATE NOT NULL,
    sexo VARCHAR(20) NOT NULL,
    rut_dueno VARCHAR(15) NOT NULL,
    PRIMARY KEY (codigo_paciente),
    CONSTRAINT fk_paciente_dueno
        FOREIGN KEY (rut_dueno)
        REFERENCES dueno (rut_dueno)
) ENGINE=InnoDB;

CREATE TABLE consulta (
    codigo_consulta INT NOT NULL,
    fecha DATE NOT NULL,
    hora TIME NOT NULL,
    motivo VARCHAR(255) NOT NULL,
    diagnostico VARCHAR(255) NOT NULL,
    observaciones TEXT NULL,
    codigo_paciente INT NOT NULL,
    id_veterinario INT NOT NULL,
    PRIMARY KEY (codigo_consulta),
    CONSTRAINT fk_consulta_paciente
        FOREIGN KEY (codigo_paciente)
        REFERENCES paciente (codigo_paciente),
    CONSTRAINT fk_consulta_veterinario
        FOREIGN KEY (id_veterinario)
        REFERENCES veterinario (id_veterinario)
) ENGINE=InnoDB;

CREATE TABLE tratamiento (
    codigo_tratamiento INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT NOT NULL,
    duracion_estimada INT NOT NULL,
    PRIMARY KEY (codigo_tratamiento),
    CONSTRAINT ck_tratamiento_duracion
        CHECK (duracion_estimada > 0)
) ENGINE=InnoDB;

CREATE TABLE procedimiento (
    codigo_procedimiento INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT NOT NULL,
    costo DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (codigo_procedimiento),
    CONSTRAINT ck_procedimiento_costo
        CHECK (costo >= 0)
) ENGINE=InnoDB;

CREATE TABLE paciente_tratamiento (
    id_asignacion INT NOT NULL,
    fecha_inicio DATE NOT NULL,
    fecha_termino DATE NULL,
    dosis_indicacion VARCHAR(255) NOT NULL,
    observaciones TEXT NULL,
    codigo_paciente INT NOT NULL,
    codigo_tratamiento INT NOT NULL,
    PRIMARY KEY (id_asignacion),
    CONSTRAINT fk_pt_paciente
        FOREIGN KEY (codigo_paciente)
        REFERENCES paciente (codigo_paciente),
    CONSTRAINT fk_pt_tratamiento
        FOREIGN KEY (codigo_tratamiento)
        REFERENCES tratamiento (codigo_tratamiento),
    CONSTRAINT ck_pt_fechas
        CHECK (fecha_termino IS NULL OR fecha_termino >= fecha_inicio)
) ENGINE=InnoDB;

CREATE TABLE consulta_procedimiento (
    id_realizacion INT NOT NULL,
    fecha_realizacion DATE NOT NULL,
    resultado VARCHAR(255) NOT NULL,
    codigo_consulta INT NOT NULL,
    codigo_procedimiento INT NOT NULL,
    PRIMARY KEY (id_realizacion),
    CONSTRAINT fk_cp_consulta
        FOREIGN KEY (codigo_consulta)
        REFERENCES consulta (codigo_consulta),
    CONSTRAINT fk_cp_procedimiento
        FOREIGN KEY (codigo_procedimiento)
        REFERENCES procedimiento (codigo_procedimiento)
) ENGINE=InnoDB;


